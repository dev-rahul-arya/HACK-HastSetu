# HastSetu — LLM configuration (Google Gemini API)
# Copy this file to `.env` and fill in your key. Vite only exposes VITE_* vars.
#
# NOTE: For the hackathon demo we call the API directly from the browser, so the
# key ends up in the client bundle. Production would proxy this server-side.

VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
